{
  "name": "sis-agenda-cli",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "db:local": "node scripts/local-db.mjs",
    "dev:all": "npm-run-all --parallel db:local dev:server dev:web",
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "migrate": "npm run migrate -w server",
    "build": "npm run build -w server && npm run build -w web",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "npm-run-all": "^4.1.5"
  }
}
