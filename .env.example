# Copie este archivo a .env para desarrollo local. NO ponga secretos reales aqui: este archivo se sube a git.

# --- Base de datos (desarrollo local con `npm run db:local`: puerto 5433) ---
DATABASE_URL=postgres://agenda:agenda@localhost:5433/agenda

# --- Servidor ---
PORT=4000
TZ_APP=America/Guayaquil
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto

# --- Groq: interpretacion de mensajes y transcripcion de audios ---
# Tambien se puede configurar desde la web (Configuracion > Inteligencia artificial).
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
